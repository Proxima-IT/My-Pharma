# ===============================
# CORS / production
# These values are read by docker-compose and passed to the backend container.
# Adjust the domain if you change where the frontend is served from.
# ===============================
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0,46.202.194.251,mypharma.com,www.mypharma.com,mypharma.com.bd,www.mypharma.com.bd
CORS_ALLOWED_ORIGINS=https://mypharma.com,https://www.mypharma.com,https://mypharma.com.bd,https://www.mypharma.com.bd,http://46.202.194.251:3000,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://mypharma.com,https://www.mypharma.com,https://mypharma.com.bd,https://www.mypharma.com.bd,http://46.202.194.251:3000,http://localhost:3000,http://127.0.0.1:3000

# ===============================
# SSLCommerz (Bangladesh payment gateway)
# ===============================

SSLCOMMERZ_STORE_ID=mypharmacombd0live
SSLCOMMERZ_STORE_PASS='69D4C39608D6894020'
SSLCOMMERZ_IS_SANDBOX=false
# Backend public base URL used to build success/fail/cancel/ipn callback routes
SSLCOMMERZ_CALLBACK_BASE_URL=https://mypharma.com.bd
# Frontend base URL used for final redirect after callback handling
SSLCOMMERZ_FRONTEND_BASE_URL=https://mypharma.com.bd

# ===============================
# Firebase Cloud Messaging (FCM) server credentials
# Use ONE of these (in order of priority):
# 1) FIREBASE_SERVICE_ACCOUNT_FILE (relative/absolute path to JSON key file — preferred for Docker)
# 2) FIREBASE_SERVICE_ACCOUNT_JSON (single-line JSON string)
# 3) GOOGLE_APPLICATION_CREDENTIALS (absolute path to JSON key file — Google ADC standard)
# ===============================
FIREBASE_SERVICE_ACCOUNT_FILE=serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=
# Optional but recommended: expected Firebase project id for ID token verification.
FIREBASE_AUTH_PROJECT_ID=my-pharma-d45b7
# Keep true for production security.
FIREBASE_AUTH_REQUIRE_EMAIL_VERIFIED=true

# ===============================
# Email (OTP + password reset)
# ===============================
