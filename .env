# NOTE: Local-only file. This repo ignores `.env` to avoid leaking secrets.
# This file exists because `docker-compose.yml` (production) uses `env_file: .env`.
# Keep this in sync with `.env.dev` for local development.

# ===============================
# Django (backend)
# ===============================
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key-min-50-chars

# ===============================
# Database (MySQL) – required for Docker
# ===============================
MYSQL_DATABASE=mypharma_data_db
MYSQL_USER=root 
MYSQL_PASSWORD=2516
MYSQL_ROOT_PASSWORD=2516

# ===============================
# Optional: override for local runs (docker-compose sets host to "mysql")
# ===============================
# MYSQL_HOST=mysql
# MYSQL_PORT=3306

# ===============================
# Frontend build args (used when building the Next.js image)
# Set these to the URL where the API will be reached FROM THE BROWSER.
# For local Docker: http://localhost:8000
# For production: https://api.yourdomain.com
# ===============================
NEXT_PUBLIC_API_URL=https://mypharma.com/api
NEXT_PUBLIC_BACKEND_URL=https://mypharma.com
FRONTEND_PORT=3000

# ===============================
# CORS / production
# These values are read by docker-compose and passed to the backend container.
# Adjust the domain if you change where the frontend is served from.
# ===============================
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0,46.202.194.251,mypharma.com,www.mypharma.com
CORS_ALLOWED_ORIGINS=https://mypharma.com,https://www.mypharma.com,http://46.202.194.251:3000,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://mypharma.com,https://www.mypharma.com,http://46.202.194.251:3000,http://localhost:3000,http://127.0.0.1:3000

# ===============================
# SSLCommerz (Bangladesh payment gateway)
# ===============================

SSLCOMMERZ_STORE_ID=mypharmacombd0live
SSLCOMMERZ_STORE_PASS='69D4C39608D6894020'
SSLCOMMERZ_IS_SANDBOX=false
# Backend public base URL used to build success/fail/cancel/ipn callback routes
SSLCOMMERZ_CALLBACK_BASE_URL=https://mypharma.com
# Frontend base URL used for final redirect after callback handling
SSLCOMMERZ_FRONTEND_BASE_URL=https://mypharma.com