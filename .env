# NOTE: Local-only file. This repo ignores `.env` to avoid leaking secrets.
# This file exists because `docker-compose.yml` (production) uses `env_file: .env`.
# Keep this in sync with `.env.dev` for local development.

# ===============================
# Django (backend)
# ===============================
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key-min-50-chars

# ===============================
# Database (MySQL) – required for Docker
# ===============================
MYSQL_DATABASE=mypharma_data_db
MYSQL_USER=root 
MYSQL_PASSWORD=2516
MYSQL_ROOT_PASSWORD=2516

# ===============================
# Optional: override for local runs (docker-compose sets host to "mysql")
# ===============================
# MYSQL_HOST=mysql
# MYSQL_PORT=3306

# ===============================
# Frontend build args (used when building the Next.js image)
# Set these to the URL where the API will be reached FROM THE BROWSER.
# For local Docker: http://localhost:8000
# For production: https://api.yourdomain.com
# ===============================
NEXT_PUBLIC_API_URL=https://mypharma.com.bd/api
NEXT_PUBLIC_BACKEND_URL=https://mypharma.com.bd
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBJerq2zn1iR95Zdbgiy_wi9oUBUmrUyvU 
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=my-pharma-d45b7.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=my-pharma-d45b7
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=my-pharma-d45b7.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=230396365021
NEXT_PUBLIC_FIREBASE_APP_ID=1:230396365021:web:27daa1b5f005da9a90f334
