# Copy this file to .env in the project root and fill in values.
# Required for: docker-compose up

# ===============================
# Docker build (backend)
# ===============================
# Compose defaults to AWS Public ECR mirror of official python:3.12-slim (avoids flaky Docker Hub TLS).
# Uncomment only if you need to force Docker Hub instead:
# PYTHON_BASE_IMAGE=python:3.12-slim

# ===============================
# Django (backend)
# ===============================
DJANGO_SECRET_KEY=your-secret-key-min-50-chars

# ===============================
# Database (MySQL) – required for Docker
# ===============================
MYSQL_DATABASE=my_pharma
MYSQL_USER=mypharma
MYSQL_PASSWORD=change-me-secure-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ===============================
# Optional: override for local runs (docker-compose sets host to "mysql")
# ===============================
# MYSQL_HOST=mysql
# MYSQL_PORT=3306

# ===============================
# Frontend build args (used when building the Next.js image)
# Set these to the URL where the API will be reached FROM THE BROWSER.
# For local Docker: http://localhost:8000
# For production: https://api.yourdomain.com
# ===============================
NEXT_PUBLIC_API_URL=http://bluepillc.com:8001/api
NEXT_PUBLIC_BACKEND_URL=http://bluepillc.com:8001

# ===============================
# CORS / production
# ===============================
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0,bluepillc.com
CORS_ALLOWED_ORIGINS=http://bluepillc.com,https://bluepillc.com
CSRF_TRUSTED_ORIGINS=http://bluepillc.com,https://bluepillc.com

# ===============================
# SSLCommerz (Bangladesh payment)
# ===============================
# Use test credentials in sandbox; production credentials when SSLCOMMERZ_IS_SANDBOX=false
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASS=qwerty
SSLCOMMERZ_IS_SANDBOX=true

# Public backend base URL where SSLCommerz will call back:
# callbacks become:
#   <base>/api/payments/sslcommerz/success/
#   <base>/api/payments/sslcommerz/fail/
#   <base>/api/payments/sslcommerz/cancel/
#   <base>/api/payments/sslcommerz/ipn/
SSLCOMMERZ_CALLBACK_BASE_URL=http://localhost:8000

# Frontend URL for user redirection after callback handling
SSLCOMMERZ_FRONTEND_BASE_URL=http://localhost:3000
